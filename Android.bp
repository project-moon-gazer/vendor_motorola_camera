soong_namespace {
}

android_app_import {
    name: "MotCamera4",
    owner: "motorola",
    apk: "proprietary/product/priv-app/MotCamera4/MotCamera4.apk",
    overrides: ["Aperture", "Camera", "Camera2", "GoogleCameraGo", "GCamGOPrebuilt"],
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    product_specific: true,
}

android_app_import {
    name: "MotCamera3AI",
    owner: "motorola",
    apk: "proprietary/product/app/MotCamera3AI/MotCamera3AI.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}

android_app_import {
    name: "MotoSignatureApp",
    owner: "motorola",
    apk: "proprietary/system/app/MotoSignatureApp/MotoSignatureApp.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "MotoSignature2App",
    owner: "motorola",
    apk: "proprietary/system/app/MotoSignature2App/MotoSignature2App.apk",
    preprocessed: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
}

dex_import {
    name: "com.motorola.motosignature",
    owner: "motorola",
    jars: ["proprietary/system/framework/com.motorola.motosignature.jar"],
}

sh_binary {
    name: "motsettings",
    owner: "motorola",
    src: "proprietary/system_ext/bin/motsettings",
    filename: "motsettings",
    system_ext_specific: true,
}

android_app_import {
    name: "MotoSettingsProviderOverlayDPPCamera",
    owner: "motorola",
    apk: "proprietary/product/overlay/MotoSettingsProviderOverlayDPPCamera.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    product_specific: true,
}
